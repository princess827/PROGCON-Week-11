<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="wk11d02ex01_compute_average"/>
        <attribute name="authors" value="riri"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-30 06:07:35 PM"/>
        <attribute name="created" value="cmlyaTtMQVBUT1AtQlJSOEhPRTM7MjAyNi0wOS0yODswNzo1NDowMSBBTTsyNzc5"/>
        <attribute name="edited" value="cmlyaTtMQVBUT1AtQlJSOEhPRTM7MjAyNi0wOS0zMDswNjowNzozNSBQTTs5OzI5MDc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numbers" type="Integer" array="True" size="4"/>
            <declare name="average" type="Real" array="False" size=""/>
            <assign variable="numbers[0]" expression="22"/>
            <assign variable="numbers[1]" expression="9"/>
            <assign variable="numbers[2]" expression="0"/>
            <assign variable="numbers[3]" expression="17"/>
            <assign variable="average" expression="computeAverage(numbers)"/>
            <output expression="average" newline="True"/>
        </body>
    </function>
    <function name="computeAverage" type="Real" variable="average">
        <parameters>
            <parameter name="numbers" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="average" type="Real" array="False" size=""/>
            <declare name="count, num, i" type="Integer" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <assign variable="count" expression="0"/>
            <for variable="i" start="0" end="3" direction="inc" step="1">
                <assign variable="num" expression="numbers[i]"/>
                <if expression="num == 0">
                    <then>
                        <breakpoint expression="" always="True"/>
                    </then>
                    <else>
                        <assign variable="total" expression="total + num"/>
                        <assign variable="count" expression="count+1"/>
                    </else>
                </if>
            </for>
            <assign variable="average" expression="total/count"/>
        </body>
    </function>
</flowgorithm>
